<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	<OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>XamlApp</RootNamespace>
	<Platforms>AnyCPU;ARM64;x64</Platforms>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<LangVersion>latest</LangVersion>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
	<PublishAot>true</PublishAot>
	<UseUwp>true</UseUwp>
	<UseUwpTools>true</UseUwpTools>
	<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
	<AddMicrosoftVCLibsSDKReference>false</AddMicrosoftVCLibsSDKReference>
	<AddMicrosoftUniversalCRTDebugSDKReference>false</AddMicrosoftUniversalCRTDebugSDKReference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.269" />
	<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
  </ItemGroup>

</Project>
